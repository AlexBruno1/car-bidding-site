# Copy to .env (`pnpm setup` does it for you and generates the secret).

# PostgreSQL connection string. This default matches docker-compose.yml.
DATABASE_URL=postgres://app:app@localhost:5432/car_bidding

# Public base URL of the app, without a trailing slash.
APP_URL=http://localhost:3000

# Secret used to sign sessions. At least 32 characters: `openssl rand -base64 32`
AUTH_SECRET=

# Used only by `pnpm db:seed` to create the first administrator.
ADMIN_EMAIL=
ADMIN_PASSWORD=
